    "import gzip\n",
    "import json\n",
    "\n",
    "file_path = \"dataset.json.gz\"\n",
    "\n",
    "with gzip.open(file_path, \"rt\", encoding=\"utf-8\") as file:\n",
    "  data = json.load(file)\n",
    "\n",
    "print(json.dumps(data, indent=4))\n"
   ]
